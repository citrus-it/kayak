# Copyright 2026 OmniOS Community Edition (OmniOSce) Association.

MIRROR=https://mirrors.omnios.org
PROG=ipcalc
VER=0.2.0
FILE=$PROG-$VER.tar.gz
URL=$MIRROR/$PROG/$FILE

dir=`/usr/gnu/bin/mktemp -d`

(
	cd $dir
	curl -fLO $URL
	gtar -zxf $FILE
	cd $PROG-$VER
	# The makefile compiles and links in one step, so the linker mapfile
	# for a non-executable data segment goes in CFLAGS.
	# Remove 'ipcalc: ' prefix from error messages.
	for f in *; do
		[ -f "$f" ] || continue
		sed -i 's/"ipcalc: /"/' $f
	done
	gmake \
		CC=gcc \
		LIBS="-lsocket -lnsl -lresolv" \
		USE_GEOIP=no \
		USE_DYN_GEOIP=no \
		CFLAGS="-m32 -D_KERNEL -Wl,-M,/usr/lib/ld/map.noexdata"
)

out=$dir/$PROG-$VER/$PROG

if [ ! -f "$out" ]; then
	echo "Failed to build ipcalc"
	exit 1
fi

cp $out ./bin/$PROG
strip ./bin/$PROG

rm -rf $dir

